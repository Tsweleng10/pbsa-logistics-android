<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispatcher Hub"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Create Load Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/glass_bg"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assign New Load"
                    android:textColor="@color/gold"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/refInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Reference (e.g. LD-2024-99)"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_grey"/>

                <EditText
                    android:id="@+id/originInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Origin (e.g. JHB)"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_grey"/>

                <EditText
                    android:id="@+id/destInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Destination (e.g. DBN)"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_grey"/>

                <Button
                    android:id="@+id/createLoadBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/gold"
                    android:text="Assign to Driver 1"
                    android:textColor="@color/navy_dark"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Logs Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Recent Driver Activity (ELD)"
            android:textColor="@color/white"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/logsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Loading logs..."
            android:textColor="@color/text_grey"/>

    </LinearLayout>
</ScrollView>